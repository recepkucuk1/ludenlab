{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "lib": [
      "DOM",
      "ES2022"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "scripts",
    "tests",
    "remotion.config.ts"
  ],
  "exclude": [
    "scripts/assets"
  ]
}
