# apps/hub — LudenLab apex: merkezi billing + kimlik + Studio/Atölye modülleri (SUNUCU app).
# Gerçek .env COMMIT EDİLMEZ (.env gitignored). Prod'da bunlar hPanel → Node.js → Environment
# Variables'a girilir; env değişikliği HOT uygulanmaz → redeploy (main'e boş commit) gerekir.

# ── Veritabanları (Supabase, Supavisor pooler — session modu, port 5432) ──
# Merkezi DB = Studio Supabase'i, `billing` şeması (Studio `public` tabloları dokunulmaz).
HUB_DATABASE_URL=postgresql://USER:PASS@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require&schema=billing
# Studio domain DB = AYNI Supabase projesi (kgbhvruzoaqwwwkhzdex), public şema.
STUDIO_DATABASE_URL=postgresql://USER:PASS@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require
# Atölye klinik DB = AYRI Supabase projesi (uzkbuplwhnwizqflzban), RLS açık.
ATOLYE_DATABASE_URL=postgresql://USER:PASS@aws-1-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require
# DB TLS doğrulaması (denetim #19): Supabase Root 2021 CA — ham PEM (satır sonlarıyla) YA DA
# base64(PEM) tek satır (hPanel için). Tanımsızsa şifreli-ama-doğrulamasız TLS + açılış uyarısı.
DB_SSL_CA=

# ── Ortam sıkılığı (denetim #25) ──
# true → prod'da IYZICO_BASE_URL boş/sandbox ise süreç AÇILMAZ (sessizce yanlış çalışmak yerine).
# Açma sırası: (1) IYZICO_BASE_URL prod, (2) doğrula, (3) ENV_STRICT=true.
ENV_STRICT=

# ── iyzico (native Abonelik v2) ──
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# PROD: https://api.iyzipay.com · SANDBOX: https://sandbox-api.iyzipay.com (prod'da olmamalı)
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_MERCHANT_ID=

# ── Kimlik (next-auth) ──
AUTH_SECRET=
# AUTH_URL doğrulama e-postası linkinin tabanı — PROD'DA SET EDİLMELİ (yoksa link localhost'a düşer).
AUTH_URL=https://ludenlab.com
# COOKIE_DOMAIN=.ludenlab.com
NEXT_PUBLIC_APP_URL=https://ludenlab.com

# ── Cron uçları (Bearer) — bkz. scripts/cron-call.sh ──
CRON_SECRET=

# ── AI ──
ANTHROPIC_API_KEY=
# Görsel sağlayıcısı: openai (varsayılan) | flux
IMAGE_PROVIDER=openai
OPENAI_API_KEY=
# FAL_KEY=                                 # IMAGE_PROVIDER=flux ise

# ── Supabase Storage (tool-images bucket = Studio projesi) — SERVICE_ROLE_KEY GİZLİDİR ──
SUPABASE_URL=https://kgbhvruzoaqwwwkhzdex.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
TOOL_IMAGES_BUCKET=tool-images

# ── E-posta — Hostinger SMTP (nodemailer) ──
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465                              # 465 = SSL/TLS · 587 = STARTTLS
SMTP_USER=noreply@ludenlab.com
SMTP_PASS=
EMAIL_FROM=LudenLab <noreply@ludenlab.com>

# ── Kayıt bot koruması — hCaptcha (denetim #15). ÇİFT birlikte verilir; yoksa özellik kapalı. ──
# hcaptcha.com → Sites → site key (public, build'e gömülür) + secret (sunucu).
NEXT_PUBLIC_HCAPTCHA_SITEKEY=
HCAPTCHA_SECRET=

# ── Ziyaret istatistiği — Umami (çerezsiz, anonim). Website id yoksa script yüklenmez. ──
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js   # self-host'ta değiştir

# ── Hata raporlama (denetim #38) — opsiyonel; DSN yoksa Sentry devre dışı ──
SENTRY_DSN=
